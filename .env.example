# External Neon PostgreSQL URL. The app intentionally ignores DATABASE_URL.
NEON_DATABASE_URL=

# Server-side only. Never prefix these with VITE_ or send them to the browser.
KANOON_API_TOKEN=
ADMIN_PASSWORD=
SESSION_SECRET=
GEMINI_API_KEY=

KANOON_API_BASE_URL=https://api.indiankanoon.org
KANOON_MAX_API_CALLS_PER_REQUEST=28
KANOON_MAX_DOCS_PER_REQUEST=25
GEMINI_MODEL=gemini-2.5-flash